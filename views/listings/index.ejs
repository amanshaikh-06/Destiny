<% layout("/layouts/boilerplate") %>

    <h3>All Listings</h3>
    <!-- <form action="/listings/new" method="get">
      <button>Create New</button>
    </form> -->

<div class="row row-cols-1 md:row-cols-2 lg:row-cols-3 xl:row-cols-4 g-3">
<%  for (let listing of allListings){  %>
  
  <div class="col">
    <a href="/listings/<%= listing._id %>" class="listing-links">
    <div class="card" style="width: 20rem;">
  <div class="card-body">
    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing-image" style="height: 20rem">
    <div class="card-img-overlay"></div>
    <h5 class="mt-2 mb-0"><%= listing.title %></h5>
    <p class="card-text fg-2"> &#8377; <%= (listing.price ?? 0).toLocaleString("en-IN") %> for 2 nights </p>
    <small class="fg-3">Last updated 3 months ago</small>
  </div>
</div>
</a>
</div>

  <%  } %>
  
</div>
    




