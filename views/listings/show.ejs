<% layout("/layouts/boilerplate") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-3">
      <h3>Listing Details</h3>

      <div class="card col-6 show-card">
        <div class="card-body">
          <img
            name="listing[image][url]"
            src="<%= listing.image.url %>"
            class="card-img show-img"
            alt="listing_image"
          />
          <h5 class="mt-2 mb-0"><%= listing.title %></h5>
          <p class="card-text fg-2"><%= listing.description %></p>
          <small class="fg-3">
            &#8377; <%= (listing.price ?? 0).toLocaleString("en-IN") %> <br />
            <%= listing.location %> <br />
            <%= listing.country %>
          </small>
        </div>
      </div>

      <br />
      <div class="btns">
        <a
          href="/listings/<%= listing.id %>/edit"
          class="btn btn-dark col-3 edit-btn"
          >Edit</a
        ><br /><br />

        <form
          method="post"
          action="/listings/<%= listing._id %>?_method=DELETE"
        >
          <button class="mt-3 btn btn-dark offset-2 delete-btn">Delete</button>
        </form>
      </div>
      <br />
    </div>
  </div>
</body>
